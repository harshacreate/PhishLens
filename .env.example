# PhishLens configuration. Copy to .env and adjust; every value has a safe default.

# Interface and port for `make run` / `python -m phishlens.app`.
# Keep 127.0.0.1 outside Docker; the container sets 0.0.0.0 and Compose binds the
# published port to 127.0.0.1:8102.
HOST=127.0.0.1
PORT=8000

# Python logging level for access/error logs
LOG_LEVEL=INFO
